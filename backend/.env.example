# Copy to .env and fill in what you need.

# --- Core ---
# Local development
DATABASE_URL=sqlite:///deckun.db
# Neon (production): use the pooled connection string and keep sslmode=require
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me-in-production

# Optional: port to bind (PaaS usually injects PORT automatically)
# PORT=8000

# Comma/JSON list of allowed browser origins. Use exact URLs in production.
# Example: CORS_ORIGINS=["https://deckun.in","https://admin.deckun.in"]
CORS_ORIGINS=["*"]

# Public base URL of this API, used to build absolute image links behind a proxy
# or CDN. Example: https://api.deckun.in
PUBLIC_BASE_URL=

# Storefront URL (used in password-reset emails)
CUSTOMER_SITE_URL=https://deckun.in

# --- Cloudflare R2 (product/review images + branding) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deckun-media
# Public bucket domain, e.g. https://pub-xxxxxxxx.r2.dev or https://media.deckun.in
R2_PUBLIC_BASE_URL=

# --- Email (SMTP) for password reset ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=Deckun <no-reply@deckun.in>
SMTP_USE_TLS=true

# --- Google Sign-In (customer) ---
GOOGLE_CLIENT_ID=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Customer SMS / WhatsApp notifications ---
# provider: noop (log only) | whatsapp | msg91 | twilio
MESSAGING_PROVIDER=noop
MESSAGING_COUNTRY_CODE=91
MESSAGING_TIMEOUT_SECONDS=10

# WhatsApp Cloud API (Meta)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: template name. If empty, a plain text message is sent
# (Meta only allows free-form text within 24h of the customer's last message).
WHATSAPP_TEMPLATE_NAME=

# MSG91 (India SMS) — requires a DLT-approved flow template
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
